[
    {
        "code": "gen",
        "title": "Generic",
        "description": "Generic list",
        "sort": true,
        "pattern": "^\\s*(\\[?[A-Fa-f\\d:.]+\\]?\\s*[\\/-]?\\s*\\S*)",
        "emptyNetMask": 32
    },
    {
        "code": "bgp",
        "title": "BGP",
        "description": "BGP table",
        "sort": true,
        "pattern": "^\\D{0,9}([\\d./-]{7,})",
        "emptyNetMask": 24
    },
    {
        "code": "host",
        "title": "Hosts",
        "description": "Host names list",
        "hosts": true,
        "pattern": "^\\s*(\\S+)"
    },
    {
        "code": "hosts_file",
        "title": "Hosts File",
        "description": "Hosts file: each name after an address",
        "hosts": true,
        "pattern": "^\\s*[^#\\s]\\S*\\s+(?!(?:localhost(?:\\.localdomain)?|local|broadcasthost|ip6-\\S+|0\\.0\\.0\\.0)(?:\\s|#|$))([^#\\s]\\S*)"
    }
]
